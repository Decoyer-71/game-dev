<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet 패키지 캐시를 D 로 돌린다.
  기본값은 C:\Users\<user>\.nuget\packages 인데, 이 PC 의 C 드라이브 여유가 5.9GB 뿐이다
  (근거: D:\GameDev\CLAUDE.md §1). 테스트 패키지만으로도 수백 MB 가 쌓이므로 처음부터 D 로 뺀다.
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="D:\GameDev\.nuget-packages" />
  </config>
</configuration>

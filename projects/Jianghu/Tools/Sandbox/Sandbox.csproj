<Project Sdk="Microsoft.NET.Sdk">

  <!--
    밸런스 관측용 콘솔 도구. 게임의 일부가 아니라 **측정 장비**다.

    Core 로직을 그대로 불러 조합 전수 대전을 돌리고 승률표를 찍는다.
    반증 조건 2("특정 조합 하나가 명백히 우월해 나머지가 죽는다")를
    사람 눈이 아니라 숫자로 판정하기 위한 것이다. docs/jianghu-design.md §5.

    ⚠ Assets 밖이라 Unity 는 이 프로젝트를 임포트하지 않는다. 게임 빌드에 포함되지 않는다.

    실행 방법은 이 프로젝트 CLAUDE.md §3 참조.
    (XML 주석 안에는 연속 하이픈을 쓸 수 없어 명령줄을 그대로 적지 못한다)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Jianghu.Sandbox</AssemblyName>
    <RootNamespace>Jianghu.Sandbox</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JianghuCore\JianghuCore.csproj" />
  </ItemGroup>

</Project>
